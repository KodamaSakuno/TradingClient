<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TradingClient.Avalonia.ViewModels"
        xmlns:options="using:TradingClient.Avalonia.ViewModels.Options"
        xmlns:shared="using:TradingClient.Avalonia.ViewModels.Shared"
        xmlns:trading="using:TradingClient.Domain.Trading"
        xmlns:conv="using:TradingClient.Avalonia.Converters"
        x:Class="TradingClient.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TradingClient" Width="600" Height="800">

  <Window.Resources>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, JetBrains Mono, monospace</FontFamily>
    <SolidColorBrush x:Key="AskColor">#FF5A67</SolidColorBrush>
    <SolidColorBrush x:Key="BidColor">#0DBF5C</SolidColorBrush>
    <SolidColorBrush x:Key="AskDepthColor">#33FF5A67</SolidColorBrush>
    <SolidColorBrush x:Key="BidDepthColor">#330DBF5C</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBorderColor">#2A2E39</SolidColorBrush>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="8" RowSpacing="8">

    <!-- 顶部栏：交易所/产品选择 + 交易对 -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto">
      <ComboBox Grid.Column="0" ItemsSource="{Binding SelectorOptions}"
                SelectedItem="{Binding SelectedOption}"
                MinWidth="160" VerticalAlignment="Center" Margin="0,0,12,0">
        <ComboBox.ItemTemplate>
          <DataTemplate DataType="vm:SelectorOption">
            <TextBlock Text="{Binding DisplayName}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                  IsVisible="{Binding IsExchangeSelected}" VerticalAlignment="Center">
        <AutoCompleteBox Text="{Binding SymbolText, UpdateSourceTrigger=PropertyChanged}"
                         ItemsSource="{Binding SymbolSuggestions}"
                         FilterMode="ContainsOrdinal"
                         Watermark="BTC_USDT" Width="160" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding SymbolMessage}" Foreground="DarkOrange" VerticalAlignment="Center" FontSize="12"/>
      </StackPanel>

    </Grid>

    <!-- 主交易区：左订单簿 + 右侧面板 -->
    <Grid Grid.Row="1" ColumnDefinitions="*,340" ColumnSpacing="8" IsVisible="{Binding IsExchangeSelected}">

      <!-- 订单簿 -->
      <Border Grid.Column="0" BorderBrush="{StaticResource PanelBorderColor}" BorderThickness="1" CornerRadius="4" Padding="8">
        <Grid RowDefinitions="Auto,*,Auto,Auto,*" RowSpacing="2">

          <!-- 表头 -->
          <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" Margin="0,0,8,4">
            <TextBlock Text="价格" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
            <TextBlock Grid.Column="1" Text="数量" FontWeight="Bold" FontSize="12" Foreground="Gray" TextAlignment="Right"/>
            <TextBlock Grid.Column="2" Text="累计" FontWeight="Bold" FontSize="12" Foreground="Gray" TextAlignment="Right"/>
            <TextBlock Grid.Column="3" Text="" FontWeight="Bold" FontSize="12" Foreground="Gray" TextAlignment="Right"/>
          </Grid>

          <!-- 卖盘 -->
          <ItemsControl Grid.Row="1" ItemsSource="{Binding OrderBook.AskRows}" VerticalAlignment="Bottom">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="shared:OrderBookRowViewModel">
                <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch"
                        Command="{Binding $parent[Window].DataContext.SelectPriceCommand}" CommandParameter="{Binding Price}">
                  <Grid ColumnDefinitions="*,*,*,*">
                    <Rectangle Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Right" Width="{Binding DepthPercent, Mode=OneWay}"
                               Fill="{StaticResource AskDepthColor}" Opacity="0.6"/>
                    <TextBlock Grid.Column="0" Text="{Binding PriceText}" Foreground="{StaticResource AskColor}" TextAlignment="Left" FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,1"/>
                    <TextBlock Grid.Column="1" Text="{Binding QuantityText}" Foreground="White" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,1"/>
                    <TextBlock Grid.Column="2" Text="{Binding CumulativeText}" Foreground="Gray" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,1"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- 最新价/价差 -->
          <Border Grid.Row="2" Background="#1E222D" CornerRadius="3" Padding="8,4" Margin="0,4">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="{Binding OrderBook.LastPrice}" FontSize="20" FontWeight="Bold"
                         Foreground="{Binding OrderBook.LastPriceBrush}" FontFamily="{StaticResource MonoFont}"/>
              <TextBlock Text="{Binding OrderBook.SpreadText}" FontSize="11" Foreground="Gray" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"/>
            </StackPanel>
          </Border>

          <!-- 买盘 -->
          <ItemsControl Grid.Row="4" ItemsSource="{Binding OrderBook.BidRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="shared:OrderBookRowViewModel">
                <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch"
                        Command="{Binding $parent[Window].DataContext.SelectPriceCommand}" CommandParameter="{Binding Price}">
                  <Grid ColumnDefinitions="*,*,*,*">
                    <Rectangle Grid.Column="0" Grid.ColumnSpan="4" HorizontalAlignment="Right" Width="{Binding DepthPercent, Mode=OneWay}"
                               Fill="{StaticResource BidDepthColor}" Opacity="0.6"/>
                    <TextBlock Grid.Column="0" Text="{Binding PriceText}" Foreground="{StaticResource BidColor}" TextAlignment="Left" FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,1"/>
                    <TextBlock Grid.Column="1" Text="{Binding QuantityText}" Foreground="White" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,1"/>
                    <TextBlock Grid.Column="2" Text="{Binding CumulativeText}" Foreground="Gray" TextAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="0,1"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </Grid>
      </Border>

      <!-- 右侧面板：下单 + 账户 -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">

        <!-- 下单面板 -->
        <Border Grid.Row="0" BorderBrush="{StaticResource PanelBorderColor}" BorderThickness="1" CornerRadius="4" Padding="12">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">

            <!-- 开仓/平仓切换（期货） -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*" IsVisible="{Binding OrderTicket.IsFuturesProduct}">
              <Button Grid.Column="0" Content="开仓" Background="#3A3F4B" Foreground="White" HorizontalAlignment="Stretch"/>
              <Button Grid.Column="1" Content="平仓" Background="Transparent" Foreground="Gray" HorizontalAlignment="Stretch"/>
            </Grid>

            <!-- 杠杆/保证金模式 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding OrderTicket.IsFuturesProduct}">
              <ComboBox ItemsSource="{Binding FuturesPanel.MarginModes}" SelectedItem="{Binding FuturesPanel.SelectedMarginMode}" MinWidth="90"/>
              <TextBox Text="{Binding FuturesPanel.LeverageText}" Width="48" Watermark="1-125"/>
              <TextBlock Text="x" VerticalAlignment="Center" Foreground="Gray"/>
              <Button Content="应用" Command="{Binding FuturesPanel.ApplyLeverage}" Padding="8,2"/>
              <TextBlock Text="{Binding FuturesPanel.LeverageMessage}" Foreground="DarkOrange" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 持仓模式：仅期货，且仅支持双向持仓的交易所显示 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsFuturesSelected}">
              <TextBlock Text="{Binding FuturesPanel.PositionModeStatus}" VerticalAlignment="Center" FontSize="12" Foreground="Gray"/>
              <Button Content="单向" Command="{Binding FuturesPanel.SetSinglePositionMode}" Padding="8,2" IsVisible="{Binding FuturesPanel.SupportsDualPositionMode, FallbackValue=False}"/>
              <Button Content="双向" Command="{Binding FuturesPanel.SetDualPositionMode}" Padding="8,2" IsVisible="{Binding FuturesPanel.SupportsDualPositionMode, FallbackValue=False}"/>
            </StackPanel>

            <!-- 订单类型标签切换 -->
            <Grid Grid.Row="3" ColumnDefinitions="*,*" IsVisible="{Binding OrderTicket.IsFuturesProduct}" ColumnSpacing="4">
              <Button Grid.Column="0" Content="限价" Command="{Binding OrderTicket.SelectLimit}"
                      Background="{Binding OrderTicket.LimitButtonBackground}" Foreground="{Binding OrderTicket.LimitButtonForeground}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      Padding="4,2" CornerRadius="2"/>
              <Button Grid.Column="1" Content="市价" Command="{Binding OrderTicket.SelectMarket}"
                      Background="{Binding OrderTicket.MarketButtonBackground}" Foreground="{Binding OrderTicket.MarketButtonForeground}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      Padding="4,2" CornerRadius="2"/>
            </Grid>

            <!-- 现货仍用下拉（简洁兼容） -->
            <ComboBox Grid.Row="3" ItemsSource="{Binding OrderTicket.OrderTypes}" SelectedItem="{Binding OrderTicket.SelectedType}" HorizontalAlignment="Stretch"
                      IsVisible="{Binding !OrderTicket.IsFuturesProduct}"/>

            <!-- 价格 -->
            <Grid Grid.Row="4" ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Grid.Column="0" Text="{Binding OrderTicket.PriceText}" Watermark="价格" IsEnabled="{Binding OrderTicket.IsLimit}"/>
              <Button Grid.Column="1" Content="BBO" Padding="8,0" IsEnabled="{Binding OrderTicket.IsLimit}" Command="{Binding OrderTicket.SetBestPrice}"/>
            </Grid>

            <!-- 数量 -->
            <TextBox Grid.Row="5" Text="{Binding OrderTicket.QuantityText}" Watermark="数量"/>

            <!-- 比例按钮 -->
            <UniformGrid Grid.Row="6" Columns="4">
              <Button Content="25%" Command="{Binding OrderTicket.SetQuantityPercent}" CommandParameter="0.25" Padding="4,2" Margin="2,0"/>
              <Button Content="50%" Command="{Binding OrderTicket.SetQuantityPercent}" CommandParameter="0.50" Padding="4,2" Margin="2,0"/>
              <Button Content="75%" Command="{Binding OrderTicket.SetQuantityPercent}" CommandParameter="0.75" Padding="4,2" Margin="2,0"/>
              <Button Content="100%" Command="{Binding OrderTicket.SetQuantityPercent}" CommandParameter="1.00" Padding="4,2" Margin="2,0"/>
            </UniformGrid>

            <!-- 可用 / 可开 -->
            <Grid Grid.Row="7" ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="可用" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding OrderTicket.AvailableText}" FontSize="12" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Row="8" ColumnDefinitions="Auto,*" IsVisible="{Binding OrderTicket.IsFuturesProduct}">
              <TextBlock Grid.Column="0" Text="可开" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding OrderTicket.MaxOpenText}" FontSize="12" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}"
                         TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Grid>

            <!-- 风控提示 -->
            <TextBlock Grid.Row="9" Text="{Binding OrderTicket.RiskHintText}" Foreground="{Binding OrderTicket.RiskHintBrush}"
                       TextWrapping="Wrap" FontSize="12" VerticalAlignment="Bottom" FontWeight="Bold"/>

            <!-- 买入/卖出大按钮 -->
            <Grid Grid.Row="10" ColumnDefinitions="*,*" ColumnSpacing="4">
              <Button Grid.Column="0" Content="{Binding OrderTicket.BuyButtonText}" Command="{Binding OrderTicket.BuySubmit}"
                      Background="{Binding OrderTicket.BuyButtonBackground}" Foreground="White" FontWeight="Bold"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      MinHeight="42" Padding="8,0" IsEnabled="{Binding OrderTicket.IsBuyEnabled}"/>
              <Button Grid.Column="1" Content="{Binding OrderTicket.SellButtonText}" Command="{Binding OrderTicket.SellSubmit}"
                      Background="{Binding OrderTicket.SellButtonBackground}" Foreground="White" FontWeight="Bold"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      MinHeight="42" Padding="8,0" IsEnabled="{Binding OrderTicket.IsSellEnabled}"/>
            </Grid>
          </Grid>
        </Border>

        <!-- 账户面板 -->
        <Border Grid.Row="1" BorderBrush="{StaticResource PanelBorderColor}" BorderThickness="1" CornerRadius="4" Padding="12">
          <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
            <TextBlock Grid.Row="0" Text="{Binding AccountSummary}" FontWeight="Bold" FontSize="13"/>
            <Grid Grid.Row="1" ColumnDefinitions="120,160,160">
              <TextBlock Grid.Column="0" Text="Asset" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
              <TextBlock Grid.Column="1" Text="Total" FontWeight="Bold" FontSize="12" Foreground="Gray" TextAlignment="Right"/>
              <TextBlock Grid.Column="2" Text="Frozen" FontWeight="Bold" FontSize="12" Foreground="Gray" TextAlignment="Right"/>
            </Grid>
            <ScrollViewer Grid.Row="2">
              <ItemsControl ItemsSource="{Binding Balances}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="trading:AssetBalance">
                    <Grid ColumnDefinitions="120,160,160" Margin="0,2">
                      <TextBlock Grid.Column="0" Text="{Binding Asset}" FontSize="12"/>
                      <TextBlock Grid.Column="1" Text="{Binding Total}" FontSize="12" TextAlignment="Right" FontFamily="{StaticResource MonoFont}"/>
                      <TextBlock Grid.Column="2" Text="{Binding Frozen}" FontSize="12" TextAlignment="Right" FontFamily="{StaticResource MonoFont}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- 风控迁移横幅 -->
    <Border Grid.Row="1" IsVisible="{Binding HasRiskBanner}"
            Background="#4A1515" CornerRadius="4" Padding="8" Margin="0,0,0,0"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
      <TextBlock Text="{Binding RiskBannerText}" Foreground="#FF6B6B" FontWeight="Bold" TextWrapping="Wrap" />
    </Border>

    <!-- 底部标签页：持仓 / 当前委托 / 成交记录（仅合约） -->
    <TabControl Grid.Row="2" IsVisible="{Binding IsFuturesSelected}">
      <TabItem Header="持仓" IsVisible="{Binding IsFuturesSelected}">
        <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
          <!-- 强平预警：仅期货，有数据时才显示 -->
          <Border Grid.Row="0" IsVisible="{Binding FuturesPanel.HasLiquidationWarning, FallbackValue=False}"
                  Background="#3A2A15" CornerRadius="4" Padding="8" Margin="0,0,0,8">
            <TextBlock Text="{Binding FuturesPanel.LiquidationWarningText}"
                       Foreground="{Binding FuturesPanel.LiquidationWarningBrush}" FontWeight="Bold"/>
          </Border>

          <!-- 期货：持仓表 -->
          <ScrollViewer Grid.Row="1" MaxHeight="180">
            <StackPanel>
              <TextBlock Text="{Binding FuturesPanel.PositionsMessage}" Foreground="DarkOrange" FontSize="12"/>
              <Grid ColumnDefinitions="140,50,90,100,110,50,80" Margin="0,4">
                <TextBlock Grid.Column="0" Text="交易对" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
                <TextBlock Grid.Column="1" Text="方向" FontWeight="Bold" FontSize="12" Foreground="Gray"/>
                <TextBlock Grid.Column="2" Text="数量" FontWeight="Bold" FontSize="12" Foreground="Gray" TextAlignment="Right"/>
                <TextBlock Grid.Column="3" Text="开仓价" FontWeight="Bold" FontSize="12" Foreground="Gray" TextAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="未实现盈亏" FontWeight="Bold" FontSize="12" Foreground="Gray" TextAlignment="Right"/>
                <TextBlock Grid.Column="5" Text="杠杆" FontWeight="Bold" FontSize="12" Foreground="Gray" TextAlignment="Right"/>
                <TextBlock Grid.Column="6" Text="保证金" FontWeight="Bold" FontSize="12" Foreground="Gray" TextAlignment="Right"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding FuturesPanel.Positions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="trading:Position">
                    <Grid ColumnDefinitions="140,50,90,100,110,50,80" Margin="0,1">
                      <TextBlock Grid.Column="0" Text="{Binding Symbol.Raw}" FontSize="12" FontFamily="{StaticResource MonoFont}"/>
                      <TextBlock Grid.Column="1" Text="{Binding Side, Converter={x:Static conv:PositionSideConverter.Instance}}" FontSize="12"/>
                      <TextBlock Grid.Column="2" Text="{Binding Quantity}" FontSize="12" FontFamily="{StaticResource MonoFont}" TextAlignment="Right"/>
                      <TextBlock Grid.Column="3" Text="{Binding EntryPrice}" FontSize="12" FontFamily="{StaticResource MonoFont}" TextAlignment="Right"/>
                      <TextBlock Grid.Column="4" Text="{Binding UnrealizedPnl}"
                                 Foreground="{Binding UnrealizedPnl, Converter={x:Static conv:PnlBrushConverter.Instance}}" FontSize="12" FontFamily="{StaticResource MonoFont}" TextAlignment="Right"/>
                      <TextBlock Grid.Column="5" Text="{Binding Leverage}" FontSize="12" TextAlignment="Right"/>
                      <TextBlock Grid.Column="6" Text="{Binding MarginMode, Converter={x:Static conv:MarginModeConverter.Instance}}" FontSize="12" TextAlignment="Right"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="当前委托" IsVisible="False">
        <TextBlock Text="当前委托列表（待接入）" Margin="12" Foreground="Gray"/>
      </TabItem>

      <TabItem Header="成交记录" IsVisible="False">
        <TextBlock Text="成交记录（待接入）" Margin="12" Foreground="Gray"/>
      </TabItem>
    </TabControl>

    <!-- 状态栏 -->
    <Border Grid.Row="3" BorderBrush="{StaticResource PanelBorderColor}" BorderThickness="1" CornerRadius="4" Padding="8,4"
            IsVisible="{Binding IsExchangeSelected}">
      <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="连接" VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>
          <TextBlock Text="{Binding ConnectionStatus}" Foreground="{Binding ConnectionBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="风控" VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>
          <TextBlock Text="{Binding RiskStateText}" Foreground="{Binding RiskStateBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="{Binding OrderBook.PerfText}" FontSize="11" Foreground="Gray" FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- 期权实验室 -->
    <Border Grid.Row="1" Grid.RowSpan="3" IsVisible="{Binding IsOptionsLabSelected}"
            BorderBrush="{StaticResource PanelBorderColor}" BorderThickness="1" CornerRadius="4" Padding="12">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">

        <!-- 参数行 -->
        <WrapPanel Grid.Row="0">
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,6">
            <TextBlock Text="标的 F" VerticalAlignment="Center" />
            <TextBox Text="{Binding OptionsLab.ForwardText, UpdateSourceTrigger=PropertyChanged}" Width="64" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,6">
            <TextBlock Text="利率 r" VerticalAlignment="Center" />
            <TextBox Text="{Binding OptionsLab.RateText, UpdateSourceTrigger=PropertyChanged}" Width="56" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,6">
            <TextBlock Text="平值 σ₀" VerticalAlignment="Center" />
            <TextBox Text="{Binding OptionsLab.AtmVolText, UpdateSourceTrigger=PropertyChanged}" Width="56" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,6">
            <TextBlock Text="偏斜 a" VerticalAlignment="Center" />
            <TextBox Text="{Binding OptionsLab.SmileSkewText, UpdateSourceTrigger=PropertyChanged}" Width="56" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,6">
            <TextBlock Text="曲率 b" VerticalAlignment="Center" />
            <TextBox Text="{Binding OptionsLab.SmileCurvatureText, UpdateSourceTrigger=PropertyChanged}" Width="56" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,6">
            <TextBlock Text="档位数" VerticalAlignment="Center" />
            <TextBox Text="{Binding OptionsLab.StrikeCountText, UpdateSourceTrigger=PropertyChanged}" Width="48" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,6">
            <TextBlock Text="期限" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding OptionsLab.Tenors}" SelectedItem="{Binding OptionsLab.SelectedTenor}" MinWidth="80" />
          </StackPanel>
          <TextBlock Text="{Binding OptionsLab.ParamMessage}" Foreground="DarkOrange" VerticalAlignment="Center" />
        </WrapPanel>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="16">

          <!-- T 型报价表 -->
          <StackPanel Grid.Column="0" Spacing="2">
            <Grid ColumnDefinitions="66,54,68,54,56,66,88,66,56,54,68,54,66">
              <TextBlock Grid.Column="0" Text="C-σ" FontWeight="Bold" TextAlignment="Right" Margin="4,0" />
              <TextBlock Grid.Column="1" Text="C-Δ" FontWeight="Bold" TextAlignment="Right" Margin="4,0" />
              <TextBlock Grid.Column="2" Text="C-Γ" FontWeight="Bold" TextAlignment="Right" Margin="4,0" />
              <TextBlock Grid.Column="3" Text="C-Vega" FontWeight="Bold" TextAlignment="Right" Margin="4,0" />
              <TextBlock Grid.Column="4" Text="C-Θ" FontWeight="Bold" TextAlignment="Right" Margin="4,0" />
              <TextBlock Grid.Column="5" Text="C-理论价" FontWeight="Bold" TextAlignment="Right" Margin="4,0" />
              <TextBlock Grid.Column="6" Text="行权价" FontWeight="Bold" TextAlignment="Center" />
              <TextBlock Grid.Column="7" Text="P-理论价" FontWeight="Bold" TextAlignment="Left" Margin="4,0" />
              <TextBlock Grid.Column="8" Text="P-Θ" FontWeight="Bold" TextAlignment="Left" Margin="4,0" />
              <TextBlock Grid.Column="9" Text="P-Vega" FontWeight="Bold" TextAlignment="Left" Margin="4,0" />
              <TextBlock Grid.Column="10" Text="P-Γ" FontWeight="Bold" TextAlignment="Left" Margin="4,0" />
              <TextBlock Grid.Column="11" Text="P-Δ" FontWeight="Bold" TextAlignment="Left" Margin="4,0" />
              <TextBlock Grid.Column="12" Text="P-σ" FontWeight="Bold" TextAlignment="Left" Margin="4,0" />
            </Grid>
            <ScrollViewer MaxHeight="360">
              <ItemsControl ItemsSource="{Binding OptionsLab.Rows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="options:TQuoteRowViewModel">
                    <Grid ColumnDefinitions="66,54,68,54,56,66,88,66,56,54,68,54,66">
                      <Border Grid.Column="0" Grid.ColumnSpan="6" Background="{Binding CallBackground}" />
                      <Border Grid.Column="7" Grid.ColumnSpan="6" Background="{Binding PutBackground}" />
                      <TextBlock Grid.Column="0" Text="{Binding CallIvText}" TextAlignment="Right" Margin="4,0" />
                      <TextBlock Grid.Column="1" Text="{Binding CallDeltaText}" TextAlignment="Right" Margin="4,0" />
                      <TextBlock Grid.Column="2" Text="{Binding CallGammaText}" TextAlignment="Right" Margin="4,0" />
                      <TextBlock Grid.Column="3" Text="{Binding CallVegaText}" TextAlignment="Right" Margin="4,0" />
                      <TextBlock Grid.Column="4" Text="{Binding CallThetaText}" TextAlignment="Right" Margin="4,0" />
                      <TextBlock Grid.Column="5" Text="{Binding CallTheoText}" TextAlignment="Right" Margin="4,0" />
                      <TextBlock Grid.Column="6" Text="{Binding StrikeText}" TextAlignment="Center"
                                 FontWeight="{Binding StrikeWeight}" />
                      <TextBlock Grid.Column="7" Text="{Binding PutTheoText}" TextAlignment="Left" Margin="4,0" />
                      <TextBlock Grid.Column="8" Text="{Binding PutThetaText}" TextAlignment="Left" Margin="4,0" />
                      <TextBlock Grid.Column="9" Text="{Binding PutVegaText}" TextAlignment="Left" Margin="4,0" />
                      <TextBlock Grid.Column="10" Text="{Binding PutGammaText}" TextAlignment="Left" Margin="4,0" />
                      <TextBlock Grid.Column="11" Text="{Binding PutDeltaText}" TextAlignment="Left" Margin="4,0" />
                      <TextBlock Grid.Column="12" Text="{Binding PutIvText}" TextAlignment="Left" Margin="4,0" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>

          <!-- 波动率微笑 -->
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="波动率微笑（横轴 m，纵轴 σ）" FontWeight="Bold" />
            <Canvas Width="440" Height="180" Background="#1E222D">
              <Polyline Points="{Binding OptionsLab.SmilePoints}" Stroke="#1E6FD9" StrokeThickness="2"
                        IsVisible="{Binding OptionsLab.HasSmile}" />
              <Ellipse Width="8" Height="8" Fill="#C0392B"
                       IsVisible="{Binding OptionsLab.HasSmile}"
                       Canvas.Left="{Binding OptionsLab.AtmX}" Canvas.Top="{Binding OptionsLab.AtmY}" />
            </Canvas>
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="{Binding OptionsLab.SmileMinVolText}" FontSize="11" Foreground="Gray" />
              <TextBlock Grid.Column="1" Text="{Binding OptionsLab.SmileMaxVolText}" FontSize="11" Foreground="Gray"
                         HorizontalAlignment="Right" />
            </Grid>
          </StackPanel>
        </Grid>

        <!-- 持仓 Greeks 汇总 -->
        <StackPanel Grid.Row="2" Spacing="4">
          <TextBlock Text="持仓 Greeks 汇总（mock 持仓，数量单位：吨）" FontWeight="Bold" />
          <Grid ColumnDefinitions="220,70,70,80,80,80,80">
            <TextBlock Grid.Column="0" Text="Symbol" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Text="数量" FontWeight="Bold" TextAlignment="Right" />
            <TextBlock Grid.Column="2" Text="开仓价" FontWeight="Bold" TextAlignment="Right" />
            <TextBlock Grid.Column="3" Text="Δ" FontWeight="Bold" TextAlignment="Right" />
            <TextBlock Grid.Column="4" Text="Γ" FontWeight="Bold" TextAlignment="Right" />
            <TextBlock Grid.Column="5" Text="Vega" FontWeight="Bold" TextAlignment="Right" />
            <TextBlock Grid.Column="6" Text="Θ" FontWeight="Bold" TextAlignment="Right" />
          </Grid>
          <ItemsControl ItemsSource="{Binding OptionsLab.PositionRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="options:PositionGreeksRowViewModel">
                <Grid ColumnDefinitions="220,70,70,80,80,80,80">
                  <TextBlock Grid.Column="0" Text="{Binding SymbolText}" />
                  <TextBlock Grid.Column="1" Text="{Binding QuantityText}" TextAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="{Binding OpenPriceText}" TextAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="{Binding DeltaText}" TextAlignment="Right" />
                  <TextBlock Grid.Column="4" Text="{Binding GammaText}" TextAlignment="Right" />
                  <TextBlock Grid.Column="5" Text="{Binding VegaText}" TextAlignment="Right" />
                  <TextBlock Grid.Column="6" Text="{Binding ThetaText}" TextAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding OptionsLab.TotalsText}" FontWeight="Bold" />
          <TextBlock Text="{Binding OptionsLab.HedgeText}" Foreground="#B03A2E" FontWeight="Bold" />
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
